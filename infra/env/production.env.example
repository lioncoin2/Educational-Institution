# Production — the environment contract (P7.1, extended by P7.3). A DEPLOYED
# environment. Copy to production.env on the production host (git-ignored), set
# every secret and replace every example value, then bring the stack up (data
# tier first, migrate, then app + media):
#
#   docker compose -f infra/compose.yaml -f infra/compose.turn.yaml \
#     -f infra/compose.data.yaml --env-file infra/env/production.env up -d
#
# Every value is interpolated into the compose files, never handed to a
# container whole: the API receives its settings, LiveKit only LIVEKIT_KEYS
# (built from the key and secret below), NODE_IP and the TURN settings, and
# Postgres/Redis only their own credentials. Production runs its own LiveKit
# server, database and Redis with their own secrets: never ones that staging,
# development or a load test has used.
#
# The secrets below ship EMPTY, on purpose: compose requires each (${VAR:?}), so
# it refuses to start ANY container until all are set; nothing runs on a known
# placeholder. The API also refuses to boot on a placeholder, on a secret
# shorter than 32 bytes, on JWT, storage and LiveKit secrets that are not all
# different, on a LIVEKIT_URL that is not wss://, and on any LIVEKIT_VERSION but
# the pinned one. Generate each secret with
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The LiveKit key and secret: letters, digits, - and _ only (LiveKit reads
# "key: secret" as YAML).

NODE_ENV=production
LOG_LEVEL=info
# One proxy hop: the nginx TLS terminator in front of the API.
TRUST_PROXY=1
CORS_ORIGINS=

# --- Data tier (P7.3 / D3): the API's own Postgres 16 and Redis 7 containers,
# on the private network, reachable only by service name (db, redis). No host
# port. Set POSTGRES_PASSWORD and REDIS_PASSWORD, and the SAME value inline in
# the URL beneath each (an env file does not expand ${...} into itself).
POSTGRES_USER=institution
POSTGRES_DB=institution
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://institution:change-me@db:5432/institution
REDIS_PASSWORD=
REDIS_URL=redis://:change-me@redis:6379

JWT_SECRET=
STORAGE_SIGNING_SECRET=

LIVE_MEDIA_PROVIDER=livekit
LIVE_ROOM_NAME_PREFIX=live-production-
LIVEKIT_VERSION=1.13.7
# Client → LiveKit: the signalling URL join tickets carry. wss:// only: nginx
# takes it on public 443 and forwards it to 127.0.0.1:7880.
LIVEKIT_URL=wss://livekit.example.com
# API → LiveKit control: the private bridge gateway, plain HTTP, never public.
LIVEKIT_API_URL=http://172.30.0.1:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# The host's public IPv4: the address LiveKit advertises for media.
LIVEKIT_NODE_IP=203.0.113.10
# TURN's hostname: nginx holds its certificate, takes TLS on public 443 for it
# and forwards the decrypted stream (with PROXY protocol) to 127.0.0.1:5349.
LIVEKIT_TURN_DOMAIN=turn.example.com
