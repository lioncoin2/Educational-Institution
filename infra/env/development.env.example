# Development — the environment contract (P7.1) for running the stack on a
# developer's machine. Copy to development.env (git-ignored), set every
# secret, then:
#
#   docker compose -f infra/compose.yaml --env-file infra/env/development.env up -d
#
# Every value is interpolated into infra/compose.yaml, never handed to a
# container whole: the API receives its settings, LiveKit only LIVEKIT_KEYS
# (built from the key and secret below) and NODE_IP. Development runs its own
# LiveKit server with its own key and secret, never staging's or production's.
# No TURN here.
#
# The four secrets below ship EMPTY, on purpose: compose requires each
# (${VAR:?}), so it refuses to start ANY container — the API or LiveKit —
# until all are set; nothing can ever run on a known placeholder. Real media is
# on, so even in development the LiveKit secret must be at least 32 bytes and
# differ from JWT_SECRET and STORAGE_SIGNING_SECRET. Generate a secret with
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The key and the secret: letters, digits, - and _ only (LiveKit reads
# "key: secret" as YAML).

NODE_ENV=development
LOG_LEVEL=debug
TRUST_PROXY=false
CORS_ORIGINS=

# Empty: the API keeps its data in memory (backend/README.md). Name a Postgres
# the container can reach to keep it instead.
DATABASE_URL=
REDIS_URL=

JWT_SECRET=
STORAGE_SIGNING_SECRET=

LIVE_MEDIA_PROVIDER=livekit
LIVE_ROOM_NAME_PREFIX=live-development-
LIVEKIT_VERSION=1.13.7
# Client → LiveKit: clients on this machine connect to LiveKit's loopback port.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# The address LiveKit advertises for media: this machine, for clients on it.
LIVEKIT_NODE_IP=127.0.0.1
