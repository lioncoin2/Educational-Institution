# Copy to .env for local development. NEVER commit a real .env.
# development | test | staging | production — anything else refuses boot.
# staging and production are DEPLOYED environments: DATABASE_URL, REDIS_URL,
# JWT_SECRET, STORAGE_SIGNING_SECRET, LIVEKIT_URL, LIVEKIT_API_KEY and
# LIVEKIT_API_SECRET must be supplied, no secret may be a placeholder, secrets
# must be long enough and distinct, and the LiveKit URLs secure (see below).
# Each environment runs its own LiveKit server with its own key, secret and URL;
# none is ever shared.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Postgres — the system of record.
# Leave this UNSET to run without a database: modules fall back to their
# in-memory adapters, which is enough for the prototype and for every unit test.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/institution

# Postgres for the integration tests. When unset those suites skip (and say so).
# Must point at a throwaway database: the suites truncate the tables they touch.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/institution_test

# Redis — ephemeral state only (never business truth).
REDIS_URL=redis://localhost:6379

# Application access tokens. In staging and production JWT_SECRET must be at
# least 32 bytes and must not be a placeholder — the server refuses to start
# otherwise.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-in-every-environment
JWT_ISSUER=institution-api
JWT_AUDIENCE=institution-clients
JWT_ACCESS_TTL=900

# Absolute lifetime of a signed-in session, in seconds (default 30 days).
# Refreshing never extends it. PROVISIONAL — open-questions.md Q16.
REFRESH_SESSION_TTL_SECONDS=2592000

# How long the role -> permission matrix is cached per process, in seconds.
ROLE_POLICY_CACHE_SECONDS=30

# Express `trust proxy`: false, true, or a hop count. Set it to match the
# deployment — trusting a proxy that is not there lets clients forge their IP
# and escape per-IP rate limits.
TRUST_PROXY=false

# Browser origins allowed to call the API (CORS), comma-separated — for the
# Flutter web app. Leave empty to allow none; native apps do not need it.
# Exact origins only (https://host[:port]); a wildcard is refused.
# The same list decides which browser pages may open the realtime WebSocket
# (/realtime): CORS does not cover WebSockets, so the server checks Origin itself.
CORS_ORIGINS=

# LiveKit (the media server). These secrets stay server-side; the Flutter client
# never sees them. LIVEKIT_URL is the client-facing signalling URL placed in join
# tickets (ws:// or wss://; wss:// only in staging and production, real media
# or not). LIVEKIT_API_URL is where this API calls LiveKit's server API —
# e.g. http://livekit:7880 over a private network; unset, it is LIVEKIT_URL with
# ws->http, wss->https. Set in staging or production, real media or not, it must
# be https:// unless its host is internal (loopback, a single-label service name
# or a private IPv4 address): the admin token on every call never crosses a
# public network in clear. LIVEKIT_VERSION is the LiveKit server release
# deployed; real media refuses to boot unless it is exactly the pinned 1.13.7.
LIVEKIT_URL=wss://livekit.example.com
# LIVEKIT_API_URL=http://livekit:7880
LIVEKIT_VERSION=1.13.7
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change-me

# Live sessions. Real media is off unless asked for by name.
# With LIVEKIT_API_SECRET unset (its development default) live binds a fake that
# never carries media. Any other secret — the change-me above included — binds,
# without LIVE_MEDIA_PROVIDER=livekit, a provider that refuses every call:
# starting a session answers 503 and stores nothing. Setting it refuses boot
# unless LIVE_ROOM_NAME_PREFIX, LIVEKIT_URL, LIVEKIT_VERSION, LIVEKIT_API_KEY and
# LIVEKIT_API_SECRET are all set — the key not a placeholder, the secret at least
# 32 bytes, not a placeholder, and different from JWT_SECRET and
# STORAGE_SIGNING_SECRET. Even then Start waits for LiveKit's /rtc/validate
# self-check: reachable, our credentials accepted, room.auto_create off.
# LIVE_MEDIA_PROVIDER=livekit
# The media rooms' name prefix, unique to this deployment: the orphan sweep ends
# every room of its form that no live session claims. 1-48 of A-Z a-z 0-9 . _ -
# LIVE_ROOM_NAME_PREFIX=live-mydeployment-
# Listener seats per session (the soft cap), and the seats above it kept for
# moderators and speakers. PROVISIONAL (Q57): raised only after load testing.
# LIVE_MAX_PARTICIPANTS_PER_SESSION=300
# LIVE_MODERATOR_RESERVE=10

# Local object storage root (used by the LocalStorageProvider adapter).
STORAGE_LOCAL_ROOT=./.storage

# Signs upload and download URLs for stored files. A different value from
# JWT_SECRET: in staging and production it must be at least 32 bytes, not a
# placeholder, and not equal to JWT_SECRET — the server refuses to start otherwise.
STORAGE_SIGNING_SECRET=change-me

# Community chats: above this many members a community's chat refuses new
# posts (412) until load testing shows a larger size is served — an engineering
# switch (community-chat.md §11.2), never a limit on who may join a community.
# Reading and read marks are unaffected. PROVISIONAL (Q26).
MESSAGING_COMMUNITY_CHAT_MAX_SERVED_MEMBERS=250
