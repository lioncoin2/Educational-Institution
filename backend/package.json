{
  "name": "@institution/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Modular monolith backend for the educational institution platform",
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" drizzle.config.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" drizzle.config.ts",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" drizzle.config.ts",
    "test": "jest",
    "test:arch": "jest --testPathPatterns=architecture",
    "arch:graph": "depcruise src --config .dependency-cruiser.cjs",
    "db:generate": "drizzle-kit generate",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run arch:graph && npm test",
    "db:migrate": "drizzle-kit migrate",
    "test:integration": "jest --testPathPatterns=drizzle",
    "identity:bootstrap-owner": "node dist/cli/bootstrap-owner.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "drizzle-orm": "^0.44.0",
    "ioredis": "^5.4.1",
    "livekit-server-sdk": "^2.9.0",
    "nestjs-pino": "^4.1.0",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "dependency-cruiser": "^16.0.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  }
}
