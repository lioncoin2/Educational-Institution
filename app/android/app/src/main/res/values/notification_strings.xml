    <string name="notification_live_speaker_granted_body_private">أُذن لك بالتحدث في البث المباشر.</string>

    <!-- ATTENDANCE -->
    <string name="notification_attendance_snapshot_recorded_title">تسجيل حضور</string>
    <string name="notification_attendance_snapshot_recorded_body_private">سُجّل الحضور في جلسة مباشرة.</string>

    <!-- TASKS (ADR 0052) -->
    <string name="notification_task_published_title">مهمة جديدة</string>
