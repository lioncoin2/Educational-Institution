<?xml version="1.0" encoding="utf-8"?>
<!-- What a push notification says on this phone (ADR 0058). The server sends
     only these resource NAMES (FCM title_loc_key / body_loc_key: the domain key
     notification.<type>.title / .body_private with dots as underscores); Android
     renders the text from here. Lock-screen safe by design: the kind of thing
     that happened, never a name, a title or a message.

     Every type the server can create needs both strings BEFORE the server
     activates it (test/notifications/push_android_resources_test.dart reads the
     server's catalog), and res/raw/keep.xml keeps them through resource
     shrinking — nothing in the app's code references them. -->
<resources>
    <!-- Notification channels: one per category, as the server names them. -->
    <string name="notification_channel_messages">الرسائل</string>
    <string name="notification_channel_community">المجتمعات</string>
    <string name="notification_channel_live">البث المباشر</string>
    <string name="notification_channel_attendance">الحضور</string>
    <string name="notification_channel_tasks">المهام اليومية</string>

    <!-- MESSAGES -->
    <string name="notification_message_received_title">رسالة جديدة</string>
    <string name="notification_message_received_body_private">لديك رسالة جديدة.</string>
    <string name="notification_conversation_created_title">محادثة جديدة</string>
    <string name="notification_conversation_created_body_private">أُضفت إلى محادثة جديدة.</string>
    <string name="notification_added_to_conversation_title">أُضفت إلى محادثة</string>
    <string name="notification_added_to_conversation_body_private">أضافك أحدهم إلى محادثة.</string>

    <!-- COMMUNITY -->
    <string name="notification_community_member_added_title">انضمام إلى مجتمع</string>
    <string name="notification_community_member_added_body_private">أصبحت عضوًا في أحد المجتمعات.</string>
    <string name="notification_community_member_removed_title">إزالة من مجتمع</string>
    <string name="notification_community_member_removed_body_private">أُزلت من أحد المجتمعات.</string>
    <string name="notification_community_capability_granted_title">صلاحية جديدة</string>
    <string name="notification_community_capability_granted_body_private">مُنحت صلاحية جديدة في أحد المجتمعات.</string>
    <string name="notification_community_capability_revoked_title">سحب صلاحية</string>
    <string name="notification_community_capability_revoked_body_private">سُحبت منك صلاحية في أحد المجتمعات.</string>
    <string name="notification_community_ownership_transferred_title">ملكية مجتمع</string>
    <string name="notification_community_ownership_transferred_body_private">أصبحت مالك أحد المجتمعات.</string>

    <!-- LIVE (a raised hand is never pushed, ADR 0024; its words are kept for completeness) -->
    <string name="notification_live_speaker_requested_title">طلب كلمة</string>
    <string name="notification_live_speaker_requested_body_private">رفع أحد المشاركين يده في البث.</string>
