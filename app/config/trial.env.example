# Trial build configuration for the Flutter web client (compile-time defines).
#
# Copy to config/trial.env (git-ignored), set API_BASE_URL to the trial
# backend's address, then build the client against it reproducibly:
#
#   cd app && flutter build web --release --no-web-resources-cdn \
#     --dart-define-from-file=config/trial.env
#
# (Add --base-href "/<path>/" only when the artifact is served under a sub-path;
# the default "/" suits a root-served trial. The GitHub Pages DEMO build in
# .github/workflows/deploy-pages.yml is unrelated and stays mock-only — do not
# point it at a backend.)
#
# This file holds ONLY addresses and feature flags — NEVER a secret. The client
# embeds no JWT / storage / LiveKit secret and no database URL; its only
# credentials are the short-lived tokens it receives at sign-in. Keep it so: a
# server secret must never be passed as a --dart-define, because it would be
# baked into the published artifact.

# Where the trial backend is reachable from the browser (scheme + host[:port]).
# The backend must list this web origin in CORS_ORIGINS (it also governs the
# /realtime WebSocket's allowed Origin). Not a secret — only an address.
API_BASE_URL=https://trial-api.example.org

# Live audio (LiveKit) is a separate readiness track, off for the trial unless a
# real LiveKit server is configured and authorized. Leave false otherwise.
LIVE_MEDIA_ENABLED=false
